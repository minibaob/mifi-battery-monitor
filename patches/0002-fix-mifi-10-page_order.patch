--- a/src/model.rs
+++ b/src/model.rs
@@ -327,14 +327,17 @@ impl Settings {
                 }
                 "page_order" => {
                     if let Ok(mut order)=v.split(',').map(str::parse::<usize>).collect::<Result<Vec<_>,_>>() {
-                        // 旧配置的页面数比现在少：缺的页按索引补到最后，已有顺序不变。
                         let total=crate::app::PAGE_NAMES.len();
-                        for page in 0..total {
-                            if order.len()>=total {break;}
-                            if !order.contains(&page) {order.push(page);}
-                        }
-                        if order.len()==total && (0..total).all(|page|order.contains(&page)) {
-                            s.page_order.copy_from_slice(&order);
+                        // 先校验：不能越界、不能重复。非法配置整条丢弃，沿用默认顺序。
+                        let sane=order.len()<=total
+                            && order.iter().enumerate().all(|(i,&page)|page<total && !order[..i].contains(&page));
+                        if sane {
+                            // 旧配置的页面数比现在少：缺的页按索引补到最后，已有顺序不变。
+                            for page in 0..total {
+                                if order.len()>=total {break;}
+                                if !order.contains(&page) {order.push(page);}
+                            }
+                            if order.len()==total {s.page_order.copy_from_slice(&order);}
                         }
                     }
                 }
