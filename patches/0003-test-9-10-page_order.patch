+++ b/src/model.rs
@@ -329,8 +329,13 @@ impl Settings {
                     if let Ok(mut order)=v.split(',').map(str::parse::<usize>).collect::<Result<Vec<_>,_>>() {
                         let total=crate::app::PAGE_NAMES.len();
                         // 先校验：不能越界、不能重复。非法配置整条丢弃，沿用默认顺序。
-                        let sane=order.len()<=total
-                            && order.iter().enumerate().all(|(i,&page)|page<total && !order[..i].contains(&page));
+                        // 只接受「长度接近总数、且正好是 0..len 的一个排列」的顺序。
+                        // 这样既能兼容旧版本更短的配置（缺的页补在末尾），又不会放过
+                        // 含重复或乱序缺项的非法值。
+                        let mut sorted=order.clone();
+                        sorted.sort_unstable();
+                        let exact=sorted.iter().copied().eq(0..order.len());
+                        let sane=exact && order.len()>=total.saturating_sub(2);
                         if sane {
                             // 旧配置的页面数比现在少：缺的页按索引补到最后，已有顺序不变。
                             for page in 0..total {
