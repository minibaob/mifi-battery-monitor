++pub fn push(token: &str, title: &str, content: &str) -> bool {
++    if token.trim().is_empty() {
++        return false;
++    }
++    let payload = serde_json::json!({
++        "token": token.trim(),
++        "title": title,
++        "content": content,
++        "template": "txt",
++    })
++    .to_string();
++    let result = ureq::AgentBuilder::new()
++        .timeout(Duration::from_secs(10))
++        .build()
++        .post(PUSHPLUS_URL)
++        .set("Content-Type", "application/json")
++        .send_string(&payload);
++    matches!(result, Ok(resp) if (200..300).contains(&resp.status()))
++}
