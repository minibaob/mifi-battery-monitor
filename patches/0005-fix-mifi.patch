++}
++
++fn offline(previous: &Snapshot, error: String) -> Snapshot {
++    Snapshot {
++        online: false,
++        error,
++        // 关键：电量与更新时间全部沿用上次有效值，绝不置 0
++        ..previous.clone()
++    }
++}
