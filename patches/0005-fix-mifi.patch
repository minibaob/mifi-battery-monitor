++/// 后台轮询线程。配置变更时由上层丢弃旧 worker 再 `start` 一个新的。
++pub struct Worker {
++    rx: Receiver<Snapshot>,
++    wake: Sender<()>,
++}
++
++impl Worker {
++    pub fn start(cfg: Config) -> Self {
++        let (tx, rx) = mpsc::channel();
++        let (wake, wake_rx) = mpsc::channel::<()>();
++        thread::spawn(move || {
++            let agent = agent();
++            let mut alerts = Alerts::new();
++            let mut previous = Snapshot::default();
++            let started = std::time::Instant::now();
++            loop {
++                let now = started.elapsed().as_secs_f64();
++                let snapshot = sample(&agent, &cfg, now, &previous);
++                if snapshot.online {
++                    previous = snapshot.clone();
++                }
++                if let Some(message) = alerts.evaluate(&snapshot, &cfg, now) {
++                    push(&cfg.token, &message.title, &message.content);
++                }
++                if tx.send(snapshot).is_err() {
++                    break;
++                }
++                match wake_rx.recv_timeout(Duration::from_secs(cfg.interval_seconds.max(10))) {
++                    Ok(()) | Err(RecvTimeoutError::Timeout) => {}
++                    Err(RecvTimeoutError::Disconnected) => break,
++                }
++            }
++        });
++        Self { rx, wake }
++    }
++
++    pub fn try_recv(&self) -> Option<Snapshot> {
++        self.rx.try_recv().ok()
++    }
++
++    pub fn refresh(&self) {
++        let _ = self.wake.send(());
++    }
++}
