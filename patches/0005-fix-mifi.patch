++/// 采一次样。失败时沿用 `previous` 的有效电量，仅标 `online=false`。
++pub fn sample(agent: &ureq::Agent, cfg: &Config, now: f64, previous: &Snapshot) -> Snapshot {
++    let response = agent.get(&url(cfg)).call();
++    match response {
++        Ok(resp) => {
++            let body = resp.into_string().unwrap_or_default();
++            match parse(&body, now) {
++                Ok(snapshot) => snapshot,
++                Err(error) => offline(previous, error),
++            }
++        }
++        Err(ureq::Error::Status(code, _)) => offline(previous, format!("HTTP {code}")),
++        Err(err) => offline(previous, format!("设备不可达: {err}")),
