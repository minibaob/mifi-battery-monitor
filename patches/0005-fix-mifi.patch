++            path: settings.mifi_path.clone(),
++            token: settings.mifi_token.clone(),
++            low: settings.mifi_low.clamp(1, 100),
++            critical: settings.mifi_critical.clamp(1, 100).min(settings.mifi_low),
++            cooldown_minutes: settings.mifi_cooldown_minutes.max(1),
++            interval_seconds: 60,
++        }
++    }
++
++    /// 每帧调用：配置变了就重建线程，收到了就更新快照。
++    pub fn pump(&mut self, settings: &Settings, env: &Env) {
++        let config = Self::config(settings);
++        if !config.enabled {
++            if self.worker.take().is_some() {
++                self.snapshot = Snapshot::default();
++                self.last_clock = None;
++                self.signature.clear();
++            }
++            return;
++        }
++
++        let signature = format!(
++            "{}|{}|{}|{}|{}|{}",
++            config.host, config.path, config.token, config.low, config.critical, config.cooldown_minutes
++        );
++        if self.worker.is_none() || signature != self.signature {
++            self.worker = Some(mifi::Worker::start(config));
++            self.signature = signature;
++            self.snapshot = Snapshot::default();
++            self.last_clock = None;
++        }
++
++        while let Some(snapshot) = self.worker.as_ref().and_then(mifi::Worker::try_recv) {
++            if snapshot.online {
++                self.last_clock = Some(env.clock.chars().take(5).collect());
++            }
++            self.snapshot = snapshot;
++        }
++    }
++
++    pub fn refresh(&self) {
++        if let Some(worker) = &self.worker {
++            worker.refresh();
++        }
++    }
