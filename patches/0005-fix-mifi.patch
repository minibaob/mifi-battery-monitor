+@@ -0,0 +1,432 @@
++//! 波导 M03X（ASR1803）随身 WiFi 电量监控。
++//!
++//! 数据源是设备局域网 Web 接口 `json_status_info`：只读、无需认证、返回 22 个字符串字段。
++//! 该固件**不提供**电池电压，只有 `battery_percent`(0-100) 与三个状态位，所以阈值判断
++//! 一律基于百分比。
++//!
++//! 三条铁律：
++//! 1. 采样失败绝不把电量当成 0：保留上一次有效快照，只把 `online` 置 false。
++//! 2. 提醒只在等级上升时触发，同级冷却；15% 直接掉到 8% 只发紧急，不补发普通。
++//! 3. 充电（含已充满）时暂停提醒并复位等级。
++
++use std::sync::mpsc::{self, Receiver, RecvTimeoutError, Sender};
++use std::thread;
++use std::time::Duration;
++
++pub const DEFAULT_HOST: &str = "192.168.1.1";
++pub const DEFAULT_PATH: &str = "/xml_action.cgi?method=get&module=duster&file=json_status_info";
++pub const PUSHPLUS_URL: &str = "https://www.pushplus.plus/send";
++
++#[derive(Clone, Debug, PartialEq)]
++pub struct Config {
++    pub enabled: bool,
++    pub host: String,
++    pub path: String,
++    pub token: String,
++    pub low: u8,
++    pub critical: u8,
++    pub cooldown_minutes: u32,
++    pub interval_seconds: u64,
++}
++
++impl Default for Config {
++    fn default() -> Self {
++        Self {
++            enabled: false,
++            host: DEFAULT_HOST.to_string(),
++            path: DEFAULT_PATH.to_string(),
++            token: String::new(),
++            low: 20,
++            critical: 10,
++            cooldown_minutes: 30,
++            interval_seconds: 60,
++        }
++    }
++}
++
++/// 一次采样的结果。`pct` 为 `None` 表示从未取到过有效值——界面必须显示"离线/—"，
++/// 不能退化成 0%。
++#[derive(Clone, Debug, Default, PartialEq)]
++pub struct Snapshot {
++    pub online: bool,
++    pub pct: Option<u8>,
++    pub charging: bool,
++    pub charge_text: &'static str,
++    pub present: bool,
++    pub rssi: Option<i32>,
++    pub signal: Option<u8>,
++    /// 最后一次**成功**采样的本地秒数；失败时保持不变。
++    pub updated: Option<f64>,
++    pub error: String,
++}
++
++impl Snapshot {
++    pub fn level(&self, cfg: &Config) -> Option<Level> {
++        if !self.online {
++            return None;
++        }
++        let pct = self.pct?;
++        if self.charging {
++            return Some(Level::Ok);
++        }
++        Some(if pct <= cfg.critical {
++            Level::Critical
++        } else if pct <= cfg.low {
++            Level::Low
++        } else {
++            Level::Ok
++        })
++    }
++}
++
++#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord)]
++pub enum Level {
++    Ok = 0,
++    Low = 1,
++    Critical = 2,
++}
++
++#[derive(Clone, Debug, PartialEq)]
++pub struct Message {
++    pub level: Level,
++    pub title: String,
++    pub content: String,
++}
++
++/// 提醒状态机。时间由调用方传入（秒），方便单测。
++#[derive(Debug, Default)]
++pub struct Alerts {
++    level: Level,
++    last_low: Option<f64>,
++    last_critical: Option<f64>,
++}
++
++impl Default for Level {
++    fn default() -> Self {
++        Level::Ok
++    }
++}
++
++impl Alerts {
++    pub fn new() -> Self {
++        Self::default()
++    }
++
++    pub fn level(&self) -> Level {
++        self.level
++    }
++
++    pub fn evaluate(&mut self, snap: &Snapshot, cfg: &Config, now: f64) -> Option<Message> {
++        let target = snap.level(cfg)?;
++        let cooldown = cfg.cooldown_minutes.max(1) as f64 * 60.0;
++
++        if target < self.level {
++            self.level = target;
++            return None;
++        }
++        if target == self.level {
++            if target == Level::Ok {
++                return None;
++            }
++            let last = match target {
++                Level::Critical => self.last_critical,
++                _ => self.last_low,
++            };
++            if last.is_some_and(|at| now - at < cooldown) {
++                return None;
++            }
++        }
++        self.level = target;
++
++        let pct = snap.pct?;
++        let state = snap.charge_text;
++        let (title, content) = match target {
++            Level::Critical => (
++                format!("【紧急】随身 WiFi 电量仅剩 {pct}%"),
++                format!(
++                    "设备 {} 电量 {pct}%，{state}，随时可能断电，请立即充电。",
++                    cfg.host
++                ),
++            ),
++            Level::Low => (
++                format!("随身 WiFi 电量偏低 {pct}%"),
++                format!(
++                    "设备 {} 电量 {pct}%，{state}。降到 {}% 会再次提醒。",
++                    cfg.host, cfg.critical
++                ),
++            ),
++            Level::Ok => return None,
++        };
++        match target {
++            Level::Critical => self.last_critical = Some(now),
++            Level::Low => self.last_low = Some(now),
++            Level::Ok => {}
++        }
++        Some(Message {
++            level: target,
++            title,
++            content,
++        })
++    }
++
++    /// 用户关掉再打开、或改了地址时复位，避免带着旧等级继续冷却。
++    pub fn reset(&mut self) {
++        *self = Self::default();
++    }
++}
++
++fn field(value: &serde_json::Value, key: &str) -> String {
++    match value.get(key) {
++        Some(serde_json::Value::String(text)) => text.trim().to_string(),
++        Some(serde_json::Value::Number(number)) => number.to_string(),
++        _ => String::new(),
++    }
++}
++
++fn parse_number(value: &serde_json::Value, key: &str) -> Option<i64> {
++    field(value, key).parse::<i64>().ok()
++}
++
++/// 解析接口返回。所有字段在固件里都是字符串，这里同时容忍数字类型。
++pub fn parse(body: &str, now: f64) -> Result<Snapshot, String> {
++    let value: serde_json::Value =
++        serde_json::from_str(body).map_err(|err| format!("返回内容不是合法 JSON: {err}"))?;
++
++    let raw = field(&value, "battery_percent");
++    let pct = raw
++        .parse::<i64>()
++        .map_err(|_| format!("电量字段异常: {raw:?}"))?;
++    if !(0..=100).contains(&pct) {
++        return Err(format!("电量超出范围: {pct}"));
++    }
++
++    let charge = field(&value, "battery_charge");
++    let present = field(&value, "battery_connect") == "1";
++    if pct == 0 && !present {
++        return Err("电量为 0 且电池不在位，判为无效读数".to_string());
++    }
++
++    let charge_text = match charge.as_str() {
++        "1" => "充电中",
++        "2" | "3" => "已充满",
++        "0" => "未充电",
++        _ => "未知",
++    };
++
++    Ok(Snapshot {
++        online: true,
++        pct: Some(pct as u8),
++        charging: matches!(charge.as_str(), "1" | "2" | "3")
++            || field(&value, "battery_charging") == "1",
++        charge_text,
++        present,
++        rssi: parse_number(&value, "rssi").map(|v| v as i32),
++        signal: parse_number(&value, "signal_quality").map(|v| v.clamp(0, 5) as u8),
++        updated: Some(now),
++        error: String::new(),
++    })
++}
++
++fn agent() -> ureq::Agent {
++    ureq::AgentBuilder::new()
